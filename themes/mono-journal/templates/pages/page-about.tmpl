{{define "content"}}{{$p := .Item}}{{$s := .Settings}}<section class="mj-about-head mj-shell"><div><p class="mj-kicker">{{settingOr $s "about_author_role" "Designer and independent writer"}}</p><h1>{{settingOr $s "about_author_name" $p.Title}}</h1><p>{{settingOr $s "about_author_bio" $p.Excerpt}}</p><div class="mj-about-meta"><span>{{settingOr $s "about_location" "Shanghai / Remote"}}</span>{{with settingOr $s "social_email" ""}}<a href="mailto:{{.}}">{{.}}</a>{{end}}</div></div>{{$avatar := settingOr $s "about_author_avatar" ""}}<figure class="mj-about-portrait">{{if $avatar}}<img src="{{$avatar}}" alt="{{settingOr $s "about_author_name" $p.Title}}">{{else}}<span>{{authorInitials (settingOr $s "about_author_name" $p.Title)}}</span>{{end}}</figure></section><article class="mj-richtext mj-reading-shell">{{safeHTML $p.Content}}</article>{{end}}
