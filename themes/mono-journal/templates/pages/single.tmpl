{{define "content"}}{{$p := .Item}}<article class="mj-article"><header class="mj-article-head mj-reading-shell"><div class="mj-post-meta"><time>{{journalDate $p.PublishedAt}}</time><span>{{readingTime $p.Content}} {{T .Ctx "post.min_read"}}</span></div><h1>{{$p.Title}}</h1>{{if $p.Excerpt}}<p class="mj-article-deck">{{$p.Excerpt}}</p>{{end}}</header>{{if $p.ImageURL}}<figure class="mj-article-hero mj-shell">{{responsiveImagePriority $p.ImageURL $p.Title "" "100vw"}}</figure>{{end}}<div class="mj-richtext mj-reading-shell">{{safeHTML $p.Content}}</div></article>{{end}}
