{{define "content"}}<section class="mj-page-head mj-shell"><p class="mj-kicker">{{T .Ctx "search.eyebrow"}}</p><h1>{{T .Ctx "search.title"}}</h1><form class="mj-search-page" action="{{langPrefixURL .Ctx "/search"}}" method="get"><input name="q" type="search" maxlength="80" value="{{.Query}}" placeholder="{{T .Ctx "search.placeholder"}}" autofocus><button type="submit">{{T .Ctx "search.submit"}}</button></form>{{if .Query}}<p>{{len .Posts}} {{T .Ctx "search.results_for"}} “{{.Query}}”</p>{{end}}</section>{{if .Query}}<section class="mj-archive mj-shell"><div class="mj-archive-list">{{range .Posts}}<article class="mj-archive-item"><a class="mj-archive-image" href="{{langPrefixURL $.Ctx (contentURL . "post")}}">{{if .ImageURL}}{{responsiveImage .ImageURL .Title "" "(max-width:760px) 100vw,280px" "lazy"}}{{end}}</a><div><div class="mj-post-meta">{{if .Category.Name}}<span>{{.Category.Name}}</span>{{end}}<time>{{journalDate .PublishedAt}}</time></div><h2><a href="{{langPrefixURL $.Ctx (contentURL . "post")}}">{{.Title}}</a></h2><p>{{if .Excerpt}}{{.Excerpt}}{{else}}{{truncate (plainText .Content) 190}}{{end}}</p></div></article>{{else}}<p class="mj-empty">{{T .Ctx "search.empty"}}</p>{{end}}</div></section>{{end}}{{end}}
