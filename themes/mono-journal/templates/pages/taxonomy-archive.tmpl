{{define "content"}}<section class="mj-page-head mj-shell"><p class="mj-kicker">{{.TaxLabel}}</p><h1>{{.TermName}}</h1><p>{{len .Items}} {{T .Ctx "archive.entries"}}</p></section><section class="mj-archive mj-shell"><div class="mj-archive-list">{{range .Items}}<article class="mj-archive-item"><a class="mj-archive-image" href="{{langPrefixURL $.Ctx .DetailURL}}">{{if .ImageURL}}{{responsiveImage .ImageURL .Title "" "(max-width:760px) 100vw,280px" "lazy"}}{{end}}</a><div><div class="mj-post-meta"><span>{{.TypeLabel}}</span><time>{{journalDate .PublishedAt}}</time></div><h2><a href="{{langPrefixURL $.Ctx .DetailURL}}">{{.Title}}</a></h2><p>{{if .Excerpt}}{{.Excerpt}}{{else}}{{truncate (plainText .Content) 190}}{{end}}</p></div></article>{{else}}<p class="mj-empty">{{T .Ctx "post.empty"}}</p>{{end}}</div></section>{{end}}
