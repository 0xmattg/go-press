{{define "content"}}{{$p := .Item}}<article class="mj-static-page"><header class="mj-page-head mj-reading-shell"><p class="mj-kicker">{{T .Ctx "page.eyebrow"}}</p><h1>{{$p.Title}}</h1>{{if $p.Excerpt}}<p>{{$p.Excerpt}}</p>{{end}}</header>{{if $p.ImageURL}}<figure class="mj-article-hero mj-shell">{{responsiveImagePriority $p.ImageURL $p.Title "" "100vw"}}</figure>{{end}}<div class="mj-richtext mj-reading-shell">{{safeHTML $p.Content}}</div></article>{{end}}
