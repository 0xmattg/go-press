{{define "content"}}
<style>
.mj-settings{max-width:1120px}.mj-settings-head{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:20px}.mj-settings-head h2{margin:0}.mj-settings-grid{display:grid;grid-template-columns:220px minmax(0,1fr);gap:20px}.mj-settings-nav{position:sticky;top:20px;align-self:start;padding:8px;background:#fff;border:1px solid #dfe5ee;border-radius:8px}.mj-settings-nav button{width:100%;padding:10px 12px;border:0;border-radius:6px;background:transparent;text-align:left;color:#5c6b82;cursor:pointer}.mj-settings-nav button.active{color:#172033;background:#edf3ff;font-weight:600}.mj-settings-panel{display:none;padding:24px;background:#fff;border:1px solid #dfe5ee;border-radius:8px}.mj-settings-panel.active{display:block}.mj-settings-panel h3{margin:0 0 6px}.mj-settings-hint{margin:0 0 22px;color:#738099;font-size:13px}.mj-settings-fields{display:grid;grid-template-columns:1fr 1fr;gap:18px}.mj-field{margin-bottom:18px}.mj-field.full{grid-column:1/-1}.mj-field label{display:block;margin-bottom:7px;color:#344054;font-size:13px;font-weight:600}.mj-field input,.mj-field textarea,.mj-field select{width:100%;padding:10px 12px;border:1px solid #cfd7e3;border-radius:6px;background:#fff}.mj-field textarea{min-height:92px;resize:vertical}.mj-media-row{display:flex;gap:8px}.mj-media-row input{min-width:0}.mj-palette-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.mj-palette{position:relative;display:block;padding:12px;border:1px solid #dfe5ee;border-radius:7px;cursor:pointer}.mj-palette input{position:absolute;opacity:0}.mj-palette:has(input:checked){border-color:#2463eb;box-shadow:0 0 0 2px rgba(36,99,235,.12)}.mj-palette span{display:block;height:44px;margin-bottom:8px;border-radius:4px;background:#171717}.mj-palette.cobalt span{background:#2459d3}.mj-palette.forest span{background:#176447}.mj-palette.clay span{background:#a13f2d}.mj-palette strong{font-size:13px}.mj-settings-actions{display:flex;justify-content:flex-end;gap:10px;margin-top:20px;padding-top:18px;border-top:1px solid #e8ecf2}@media(max-width:800px){.mj-settings-grid{grid-template-columns:1fr}.mj-settings-nav{position:static;display:flex;overflow:auto}.mj-settings-nav button{white-space:nowrap}.mj-settings-fields,.mj-palette-grid{grid-template-columns:1fr 1fr}}@media(max-width:520px){.mj-settings-fields,.mj-palette-grid{grid-template-columns:1fr}}
</style>
<div class="mj-settings">
    <div class="mj-settings-head"><div><a href="/admin/themes" class="btn btn-secondary">&#8592; {{X $ "mono.settings.back" "返回主题管理"}}</a></div><h2>{{X $ "mono.settings.title" "%s 设置" .ThemeName}}</h2></div>
    <form method="POST" action="/admin/themes/{{.ThemeSlug}}/settings" id="monoSettingsForm">
        {{$s := .Settings}}
        <div class="mj-settings-grid">
            <nav class="mj-settings-nav" aria-label="Settings sections">
                <button class="active" type="button" data-panel="style">{{X $ "mono.settings.style" "风格与品牌"}}</button>
                <button type="button" data-panel="home">{{X $ "mono.settings.home" "首页内容"}}</button>
                <button type="button" data-panel="author">{{X $ "mono.settings.author" "作者资料"}}</button>
                <button type="button" data-panel="social">{{X $ "mono.settings.social" "社交与页脚"}}</button>
            </nav>
            <div>
                <section class="mj-settings-panel active" id="panel-style">
                    <h3>{{X $ "mono.settings.style_title" "整体风格"}}</h3><p class="mj-settings-hint">{{X $ "mono.settings.style_hint" "保持黑白主体，只切换强调色、链接和少量交互表面。"}}</p>
                    {{$palette := index $s "theme_color_scheme"}}{{if not $palette}}{{$palette = "ink"}}{{end}}
                    <div class="mj-palette-grid">
                        <label class="mj-palette"><input type="radio" name="color_scheme" value="ink" {{if eq $palette "ink"}}checked{{end}}><span></span><strong>{{X $ "mono.palette.ink" "Ink 墨黑"}}</strong></label>
                        <label class="mj-palette cobalt"><input type="radio" name="color_scheme" value="cobalt" {{if eq $palette "cobalt"}}checked{{end}}><span></span><strong>{{X $ "mono.palette.cobalt" "Cobalt 钴蓝"}}</strong></label>
                        <label class="mj-palette forest"><input type="radio" name="color_scheme" value="forest" {{if eq $palette "forest"}}checked{{end}}><span></span><strong>{{X $ "mono.palette.forest" "Forest 森绿"}}</strong></label>
                        <label class="mj-palette clay"><input type="radio" name="color_scheme" value="clay" {{if eq $palette "clay"}}checked{{end}}><span></span><strong>{{X $ "mono.palette.clay" "Clay 陶红"}}</strong></label>
                    </div>
                    <div class="mj-settings-fields" style="margin-top:22px">
                        <div class="mj-field"><label>{{X $ "mono.settings.brand_name" "站点品牌名"}}</label><input name="home_logo_text" value="{{index $s "home_logo_text"}}" placeholder="Mono Journal"></div>
                        <div class="mj-field"><label>{{X $ "mono.settings.logo" "Logo 图片"}}</label><div class="mj-media-row"><input id="home_logo_image" name="home_logo_image" value="{{index $s "home_logo_image"}}" placeholder="/uploads/logo.svg"><button type="button" class="btn btn-secondary" onclick="openMediaPicker(function(url){document.getElementById('home_logo_image').value=url})">{{X $ "mono.settings.select" "选择"}}</button></div></div>
                    </div>
                </section>
                <section class="mj-settings-panel" id="panel-home">
                    <h3>{{X $ "mono.settings.home_title" "首页编辑"}}</h3><p class="mj-settings-hint">{{X $ "mono.settings.home_hint" "控制首页开场、精选文章标签、最新文章和作者区域文案。"}}</p>
                    <div class="mj-settings-fields">
                        <div class="mj-field"><label>{{X $ "mono.settings.eyebrow" "首页眉题"}}</label><input name="home_intro_eyebrow" value="{{index $s "home_intro_eyebrow"}}"></div>
                        <div class="mj-field"><label>{{X $ "mono.settings.featured" "精选文章标签"}}</label><input name="home_featured_label" value="{{index $s "home_featured_label"}}"></div>
                        <div class="mj-field full"><label>{{X $ "mono.settings.intro_title" "首页主标题"}}</label><textarea name="home_intro_title">{{index $s "home_intro_title"}}</textarea></div>
                        <div class="mj-field full"><label>{{X $ "mono.settings.intro_text" "首页简介"}}</label><textarea name="home_intro_text">{{index $s "home_intro_text"}}</textarea></div>
                        <div class="mj-field"><label>{{X $ "mono.settings.latest" "最新文章标题"}}</label><input name="home_latest_title" value="{{index $s "home_latest_title"}}"></div>
                        <div class="mj-field"><label>{{X $ "mono.settings.about_title" "作者区域标题"}}</label><input name="home_about_title" value="{{index $s "home_about_title"}}"></div>
                        <div class="mj-field full"><label>{{X $ "mono.settings.about_text" "作者区域简介"}}</label><textarea name="home_about_text">{{index $s "home_about_text"}}</textarea></div>
                    </div>
                </section>
                <section class="mj-settings-panel" id="panel-author">
                    <h3>{{X $ "mono.settings.author_title" "作者资料"}}</h3><p class="mj-settings-hint">{{X $ "mono.settings.author_hint" "用于首页作者区域、About 页面和文章署名。"}}</p>
                    <div class="mj-settings-fields">
                        <div class="mj-field"><label>{{X $ "mono.settings.author_name" "姓名"}}</label><input name="about_author_name" value="{{index $s "about_author_name"}}"></div>
                        <div class="mj-field"><label>{{X $ "mono.settings.author_role" "身份"}}</label><input name="about_author_role" value="{{index $s "about_author_role"}}"></div>
                        <div class="mj-field"><label>{{X $ "mono.settings.location" "所在地"}}</label><input name="about_location" value="{{index $s "about_location"}}"></div>
                        <div class="mj-field"><label>{{X $ "mono.settings.avatar" "头像"}}</label><div class="mj-media-row"><input id="about_author_avatar" name="about_author_avatar" value="{{index $s "about_author_avatar"}}"><button type="button" class="btn btn-secondary" onclick="openMediaPicker(function(url){document.getElementById('about_author_avatar').value=url})">{{X $ "mono.settings.select" "选择"}}</button></div></div>
                        <div class="mj-field full"><label>{{X $ "mono.settings.bio" "个人简介"}}</label><textarea name="about_author_bio">{{index $s "about_author_bio"}}</textarea></div>
                    </div>
                </section>
                <section class="mj-settings-panel" id="panel-social">
                    <h3>{{X $ "mono.settings.social_title" "社交链接与页脚"}}</h3><p class="mj-settings-hint">{{X $ "mono.settings.social_hint" "留空的社交渠道不会显示。"}}</p>
                    <div class="mj-settings-fields">
                        <div class="mj-field"><label>Email</label><input type="email" name="social_email" value="{{index $s "social_email"}}"></div>
                        <div class="mj-field"><label>GitHub</label><input type="url" name="social_github" value="{{index $s "social_github"}}"></div>
                        <div class="mj-field"><label>X / Twitter</label><input type="url" name="social_x" value="{{index $s "social_x"}}"></div>
                        <div class="mj-field"><label>LinkedIn</label><input type="url" name="social_linkedin" value="{{index $s "social_linkedin"}}"></div>
                        <div class="mj-field full"><label>{{X $ "mono.settings.footer" "页脚文案"}}</label><textarea name="footer_text">{{index $s "footer_text"}}</textarea></div>
                    </div>
                </section>
                <div class="mj-settings-actions"><a href="/admin/themes" class="btn btn-secondary">{{X $ "mono.settings.cancel" "取消"}}</a><button type="submit" class="btn btn-primary">{{X $ "mono.settings.save" "保存设置"}}</button></div>
            </div>
        </div>
    </form>
</div>
<script>
document.querySelectorAll('.mj-settings-nav button').forEach(function(button){button.addEventListener('click',function(){document.querySelectorAll('.mj-settings-nav button').forEach(function(item){item.classList.remove('active')});document.querySelectorAll('.mj-settings-panel').forEach(function(item){item.classList.remove('active')});button.classList.add('active');document.getElementById('panel-'+button.dataset.panel).classList.add('active')})});
</script>
{{end}}
