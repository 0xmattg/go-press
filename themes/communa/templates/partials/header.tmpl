{{define "header"}}
{{$brand := settingOr .Settings "home_logo_text" "Communa"}}
<header class="cmn-header" id="cmn-header" data-site-header>
    <div class="cmn-container cmn-header-inner">
        <a class="cmn-brand" href="{{langPrefixURL .Ctx "/"}}" aria-label="{{$brand}}">
            {{$logo := settingOr .Settings "home_logo_image" ""}}
            {{if $logo}}
            <img class="cmn-brand-logo" src="{{$logo}}" alt="{{$brand}}">
            {{else}}
            <span class="cmn-brand-mark" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
            </span>
            {{end}}
            <span class="cmn-brand-text">{{$brand}}</span>
        </a>

        <button class="cmn-nav-toggle" id="cmn-nav-toggle" type="button" aria-label="Toggle navigation" aria-controls="cmn-primary-nav" aria-expanded="false">
            <span></span><span></span><span></span>
        </button>

        <nav class="cmn-nav" aria-label="Primary navigation" data-site-nav>
            <ul class="cmn-nav-menu" id="cmn-primary-nav">
                {{$menu := menuByLocation "header"}}
                {{if $menu}}
                    {{range $menu.Items}}
                    <li class="cmn-nav-item"><a href="{{.URL}}" class="cmn-nav-link {{if isMenuURLActive $.Ctx .URL}}is-active{{end}}" {{if eq .Target "_blank"}}target="_blank" rel="noopener"{{end}}>{{.Title}}</a></li>
                    {{end}}
                {{else}}
                    <li class="cmn-nav-item"><a href="{{langPrefixURL .Ctx "/"}}" class="cmn-nav-link {{if isMenuURLActive .Ctx "/"}}is-active{{end}}">{{T .Ctx "nav_home"}}</a></li>
                    <li class="cmn-nav-item"><a href="{{langPrefixURL .Ctx (archiveURL "member")}}" class="cmn-nav-link {{if isMenuURLActive .Ctx (archiveURL "member")}}is-active{{end}}">{{T .Ctx "nav_members"}}</a></li>
                    <li class="cmn-nav-item"><a href="{{langPrefixURL .Ctx (archiveURL "group")}}" class="cmn-nav-link {{if isMenuURLActive .Ctx (archiveURL "group")}}is-active{{end}}">{{T .Ctx "nav_groups"}}</a></li>
                    <li class="cmn-nav-item"><a href="{{langPrefixURL .Ctx (archiveURL "discussion")}}" class="cmn-nav-link {{if isMenuURLActive .Ctx (archiveURL "discussion")}}is-active{{end}}">{{T .Ctx "nav_discussions"}}</a></li>
                    <li class="cmn-nav-item"><a href="{{langPrefixURL .Ctx (archiveURL "post")}}" class="cmn-nav-link {{if isMenuURLActive .Ctx (archiveURL "post")}}is-active{{end}}">{{T .Ctx "nav_blog"}}</a></li>
                    <li class="cmn-nav-item"><a href="{{langPrefixURL .Ctx "/about"}}" class="cmn-nav-link {{if isMenuURLActive .Ctx "/about"}}is-active{{end}}">{{T .Ctx "nav_about"}}</a></li>
                    <li class="cmn-nav-item"><a href="{{langPrefixURL .Ctx "/contact"}}" class="cmn-nav-link {{if isMenuURLActive .Ctx "/contact"}}is-active{{end}}">{{T .Ctx "nav_contact"}}</a></li>
                {{end}}
                {{renderHook "header.nav.after" .}}
            </ul>

            <div class="cmn-nav-actions">
                {{if isLoggedIn .Ctx}}
                    {{$account := currentUser .Ctx}}
                    <span class="cmn-account">
                        <span class="cmn-avatar cmn-avatar-sm">{{if $account.AvatarURL}}<img src="{{$account.AvatarURL}}" alt="">{{else}}<span class="cmn-avatar-fallback">{{initials $account.DisplayName}}</span>{{end}}</span>
                        <span class="cmn-account-name">{{$account.DisplayName}}</span>
                    </span>
                    <form method="post" action="{{logoutURL}}" class="cmn-logout-form"><input type="hidden" name="return_to" value="{{langPrefixURL .Ctx "/"}}"><button type="submit" class="cmn-btn cmn-btn-ghost cmn-btn-sm">{{T .Ctx "auth_logout"}}</button></form>
                {{else}}
                    <a href="{{loginURL .Ctx}}" class="cmn-btn cmn-btn-green cmn-btn-sm" data-login-open aria-haspopup="dialog" aria-controls="cmn-login-modal">{{settingOr .Settings "home_login_text" (T .Ctx "auth_login")}}</a>
                    <a href="{{loginURL .Ctx}}" class="cmn-btn cmn-btn-blue cmn-btn-sm" data-login-open aria-haspopup="dialog" aria-controls="cmn-login-modal">{{settingOr .Settings "home_join_text" (T .Ctx "auth_join")}}</a>
                {{end}}
            </div>
        </nav>
    </div>
</header>
{{end}}
