{{define "content"}}
<section class="cmn-page-banner">
    <div class="cmn-container">
        <nav class="cmn-breadcrumb" aria-label="Breadcrumb">
            <a href="{{langPrefixURL .Ctx "/"}}">{{T .Ctx "nav_home"}}</a><span aria-hidden="true">/</span><span>{{.Title}}</span>
        </nav>
        <h1>{{.Title}}</h1>
        <p class="cmn-page-banner-sub">{{T .Ctx "archive_blog_sub"}}</p>
    </div>
</section>

<section class="cmn-section">
    <div class="cmn-container">
        <div class="cmn-archive-toolbar">
            <form class="cmn-inline-search" action="{{langPrefixURL .Ctx (archiveURL "post")}}" method="get" role="search">
                <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
                <input type="search" name="q" value="{{.SearchQuery}}" maxlength="80" placeholder="{{T .Ctx "form_ph_search_posts"}}" aria-label="{{T .Ctx "form_ph_search_posts"}}">
            </form>
            {{if .Categories}}
            <div class="cmn-filter-chips">
                <a href="{{langPrefixURL .Ctx (archiveURL "post")}}" class="cmn-chip{{if and (not .ActiveCat) (not .ActiveTag)}} is-active{{end}}">{{T .Ctx "filter_all"}}</a>
                {{range .Categories}}
                <a href="{{langPrefixURL $.Ctx (taxonomyURL "category" .Slug)}}" class="cmn-chip{{if eq $.ActiveCat .Slug}} is-active{{end}}">{{.Name}}</a>
                {{end}}
            </div>
            {{end}}
        </div>

        {{if .Items}}
        <div class="cmn-post-grid">
            {{range .Items}}
            <article class="cmn-post-card">
                <a class="cmn-post-card-image" href="{{langPrefixURL $.Ctx .URL}}">
                    {{if .ImageURL}}{{responsiveImage .ImageURL .Title "" "(max-width: 768px) 100vw, 33vw" "lazy"}}{{else}}<span class="cmn-post-card-ph">{{initials .Title}}</span>{{end}}
                </a>
                <div class="cmn-post-card-body">
                    <div class="cmn-post-card-meta">
                        {{if .Category.Name}}<a class="cmn-post-cat" href="{{langPrefixURL $.Ctx (taxonomyURL "category" .Category.Slug)}}">{{.Category.Name}}</a>{{end}}
                        <time>{{formatDate .PublishedAt}}</time>
                    </div>
                    <h3 class="cmn-post-card-title"><a href="{{langPrefixURL $.Ctx .URL}}">{{.Title}}</a></h3>
                    <p class="cmn-post-card-excerpt">{{if .Excerpt}}{{.Excerpt}}{{else}}{{truncate (stripTags .Content) 140}}{{end}}</p>
                    <div class="cmn-post-card-foot">
                        <span class="cmn-post-author">
                            {{$an := .AuthorName}}{{if not $an}}{{$an = (T $.Ctx "activity_a_member")}}{{end}}
                            <span class="cmn-avatar cmn-avatar-xs">{{if .AuthorAvatar}}<img src="{{.AuthorAvatar}}" alt="{{$an}}" loading="lazy">{{else}}<span class="cmn-avatar-fallback">{{initials $an}}</span>{{end}}</span>
                            {{$an}}
                        </span>
                        <a class="cmn-post-card-link" href="{{langPrefixURL $.Ctx .URL}}">{{T $.Ctx "btn_read_more"}}</a>
                    </div>
                </div>
            </article>
            {{end}}
        </div>
        {{template "cmn-pagination" .}}
        {{else}}
        <div class="cmn-empty"><p>{{T .Ctx "empty_no_posts"}}</p></div>
        {{end}}
    </div>
</section>
{{end}}
