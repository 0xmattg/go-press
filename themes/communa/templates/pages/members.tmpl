{{define "content"}}
<section class="cmn-page-banner">
    <div class="cmn-container">
        <nav class="cmn-breadcrumb" aria-label="Breadcrumb">
            <a href="{{langPrefixURL .Ctx "/"}}">{{T .Ctx "nav_home"}}</a><span aria-hidden="true">/</span><span>{{.Title}}</span>
        </nav>
        <h1>{{.Title}}</h1>
        <p class="cmn-page-banner-sub">{{T .Ctx "archive_members_sub"}} · {{.Pagination.Total}} {{T .Ctx "label_members"}}</p>
    </div>
</section>

<section class="cmn-section">
    <div class="cmn-container">
        <div class="cmn-archive-toolbar">
            <form class="cmn-inline-search" action="{{langPrefixURL .Ctx (archiveURL "member")}}" method="get" role="search">
                <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
                <input type="search" name="q" value="{{.SearchQuery}}" maxlength="80" placeholder="{{T .Ctx "form_ph_search_members"}}" aria-label="{{T .Ctx "form_ph_search_members"}}">
            </form>
            {{if .Tags}}
            <div class="cmn-filter-chips">
                <a href="{{langPrefixURL .Ctx (archiveURL "member")}}" class="cmn-chip{{if not .ActiveTag}} is-active{{end}}">{{T .Ctx "filter_all"}}</a>
                {{range .Tags}}
                <a href="{{langPrefixURL $.Ctx (printf "%s?tag=%s" (archiveURL "member") .Slug)}}" class="cmn-chip{{if eq $.ActiveTag .Slug}} is-active{{end}}">{{.Name}}</a>
                {{end}}
            </div>
            {{end}}
        </div>

        {{if .Items}}
        <div class="cmn-member-grid">
            {{range .Items}}
            <article class="cmn-member-card">
                <div class="cmn-member-card-cover"{{if .CoverImage}} style="background-image:url('{{.CoverImage}}')"{{end}}></div>
                <a class="cmn-avatar cmn-avatar-lg cmn-member-card-avatar" href="{{langPrefixURL $.Ctx .URL}}">
                    {{if .ImageURL}}<img src="{{.ImageURL}}" alt="{{.Title}}" loading="lazy">{{else}}<span class="cmn-avatar-fallback">{{initials .Title}}</span>{{end}}
                </a>
                <div class="cmn-member-card-body">
                    <h3 class="cmn-member-card-name"><a href="{{langPrefixURL $.Ctx .URL}}">{{.Title}}</a></h3>
                    <p class="cmn-member-card-role">{{if .Role}}{{.Role}}{{else}}{{T $.Ctx "member_default_role"}}{{end}}</p>
                    {{if .Location}}<p class="cmn-member-card-loc"><svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg> {{.Location}}</p>{{end}}
                    {{if .Tags}}<div class="cmn-tag-row">{{range .Tags}}<span class="cmn-tag-mini">{{.Name}}</span>{{end}}</div>{{end}}
                    <a class="cmn-btn cmn-btn-outline cmn-btn-sm cmn-btn-block" href="{{langPrefixURL $.Ctx .URL}}">{{T $.Ctx "btn_view_profile"}}</a>
                </div>
            </article>
            {{end}}
        </div>
        {{template "cmn-pagination" .}}
        {{else}}
        <div class="cmn-empty">
            <p>{{T .Ctx "empty_no_members"}}</p>
        </div>
        {{end}}
    </div>
</section>
{{end}}
