{{define "base"}}<!DOCTYPE html>
<html lang="{{currentLang .Ctx}}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{pageTitleFor . "GoPress"}}</title>
{{seoHeadFor .}}
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&display=swap">
<link rel="stylesheet" href="/static/css/style.css?v={{goPressVersion}}">
<script type="application/ld+json">{"@context": "https://schema.org", "@type": "WebSite", "name": "{{settingOr .Settings "site_name" "GoPress"}}"}</script>
</head>
<body>
{{template "header" .}}
<main class="site-main">{{block "content" .}}{{end}}</main>
<footer class="site-footer">&copy; {{currentYear}}</footer>
</body>
</html>{{end}}
