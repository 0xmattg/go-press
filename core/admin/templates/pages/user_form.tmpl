{{define "content"}}
<div class="content-header">
    <h2>{{.Title}}</h2>
    <a href="/admin/users" class="btn">{{T . "action.back_to_list"}}</a>
</div>
<div class="card">
    <form method="POST" action="/admin/users/{{if .Item}}{{.Item.ID}}/edit{{else}}new{{end}}">
        <div class="form-row">
            <div class="form-group">
                <label for="username">{{T . "field.username"}} *</label>
                <input type="text" id="username" name="username" value="{{if .Item}}{{.Item.Username}}{{end}}" required {{if .Item}}readonly{{end}}>
            </div>
            <div class="form-group">
                <label for="email">{{T . "field.email"}} *</label>
                <input type="email" id="email" name="email" value="{{if .Item}}{{.Item.Email}}{{end}}" required>
            </div>
        </div>
        <div class="form-row">
            <div class="form-group">
                <label for="display_name">{{T . "field.display_name"}}</label>
                <input type="text" id="display_name" name="display_name" value="{{if .Item}}{{.Item.DisplayName}}{{end}}">
            </div>
            <div class="form-group">
                <label for="role">{{T . "field.role"}} *</label>
                <select id="role" name="role" required>
                    {{range .Roles}}
                    <option value="{{.}}" {{if and $.Item (eq $.Item.Role .)}}selected{{end}}>{{roleDisplayFor $ .}}</option>
                    {{end}}
                </select>
            </div>
        </div>
        <div class="form-group">
            <label for="password">{{T . "field.password"}} {{if .Item}}{{T . "form.password_edit_hint"}}{{else}}*{{end}}</label>
            <input type="password" id="password" name="password" {{if not .Item}}required{{end}} minlength="6">
        </div>
        {{if .Item}}
        <div class="form-group">
            <label class="checkbox-label">
                <input type="checkbox" name="is_active" value="1" {{if .Item.IsActive}}checked{{end}}>
                {{T . "user.active"}}
            </label>
        </div>
        {{end}}
        {{if .AskSecondFactor}}
        <div class="form-group mfa-field">
            <label for="otp_code">{{T . "mfa.code_label"}}</label>
            <input type="text" id="otp_code" name="otp_code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9 ]{6,7}" maxlength="7" class="mfa-code-input" placeholder="123456">
            <p class="form-help">{{T . "mfa.user_form_help"}}</p>
        </div>
        {{end}}
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">{{T . "action.save"}}</button>
            <a href="/admin/users" class="btn">{{T . "action.cancel"}}</a>
        </div>
    </form>
</div>
{{if and .Item .TargetSecondFactor}}
<div class="card settings-shell account-security">
    <section class="settings-section">
        <div class="mfa-heading">
            <h3 class="settings-section-title">{{T . "mfa.section_title"}}</h3>
            <span class="badge badge-published">{{T . "mfa.state_on"}}</span>
        </div>
        <form method="POST" action="/admin/users/{{.Item.ID}}/mfa-reset" class="mfa-form">
            <p class="form-help">{{T . "mfa.reset_help"}}</p>
            {{if .AskSecondFactor}}
            <div class="form-group">
                <label for="mfaResetCode">{{T . "mfa.code_label"}}</label>
                <input type="text" id="mfaResetCode" name="otp_code" required inputmode="numeric" autocomplete="one-time-code" pattern="[0-9 ]{6,7}" maxlength="7" class="mfa-code-input" placeholder="123456">
            </div>
            {{end}}
            <button type="submit" class="btn btn-danger">{{T . "mfa.reset"}}</button>
        </form>
    </section>
</div>
{{end}}
{{end}}
