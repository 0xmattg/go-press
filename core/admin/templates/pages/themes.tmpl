{{define "content"}}
<div class="content-header">
    <h2>{{T . "nav.themes"}}</h2>
    {{if can .CurrentRole "extension" "read"}}
    <a href="/admin/themes/market" class="btn btn-primary">{{T . "ext.market_title"}}</a>
    {{end}}
</div>

{{if .ThemeLoadIssues}}
<div class="alert alert-error dep-warning" role="alert">
    <div class="dep-warning-text">
        <strong>{{T . "theme.load_issues_title"}}</strong>
        <ul style="margin:.35rem 0 0;padding-left:1.25rem;">
            {{range .ThemeLoadIssues}}<li><code>{{.Slug}}</code> — {{.Reason}}</li>{{end}}
        </ul>
        {{if can .CurrentRole "extension" "read"}}
        <a href="/admin/themes/market?tab=installed" class="theme-issues-link">{{T . "theme.manage_packages"}}</a>
        {{end}}
    </div>
</div>
{{end}}

<div class="extension-grid theme-grid">
    {{range .Themes}}
    <article class="card extension-card theme-card{{if .Active}} extension-card-active theme-active{{end}}">
        <div class="extension-card-main">
            {{if .LogoSVG}}<span class="extension-logo" aria-hidden="true">{{.LogoSVG}}</span>{{end}}
            <div class="extension-card-content">
                <div class="extension-card-heading">
                    <h3 title="{{.Name}}">{{.Name}}</h3>
                    <div class="extension-card-badges">
                        <span class="extension-version">v{{.Version}}</span>
                        {{if .Package}}<span class="badge badge-package">{{if eq .PackageSource "market"}}{{T $ "ext.source_market"}}{{else if eq .PackageSource "upload"}}{{T $ "ext.source_upload"}}{{else}}{{T $ "ext.source_preview"}}{{end}}</span>{{end}}
                        {{if .Unsigned}}<span class="badge badge-danger">{{T $ "ext.unsigned"}}</span>{{end}}
                        {{if .Revoked}}<span class="badge badge-danger" title="{{T $ "theme.revoked_cannot_switch"}}">{{T $ "ext.revoked"}}</span>{{end}}
                        {{if .UpdateVersion}}{{$urgent := or (eq .UpdateSeverity "security") (eq .UpdateSeverity "unsupported")}}{{$label := T $ "ext.update_version" .UpdateVersion}}{{if eq .UpdateSeverity "security"}}{{$label = T $ "ext.update_version_security" .UpdateVersion}}{{end}}{{if can $.CurrentRole "extension" "read"}}<a class="badge badge-update{{if $urgent}} badge-update-urgent{{end}}" href="/admin/themes/market#market-{{.Slug}}">{{$label}}</a>{{else}}<span class="badge badge-update{{if $urgent}} badge-update-urgent{{end}}">{{$label}}</span>{{end}}{{end}}
                        {{if .DepBlocked}}<span class="badge badge-dep-blocked" title="{{.DepReason}}">{{T $ "deps.badge_blocked"}}</span>
                        {{else if .DepInactivePlugins}}<span class="badge badge-dep-warn" title="{{.DepInactiveSummary}}">{{T $ "deps.badge_needs"}}</span>{{end}}
                        {{if .Active}}<span class="badge badge-active">{{T $ "theme.active"}}</span>{{end}}
                    </div>
                </div>
                <div class="extension-desc-wrap" data-extension-description>
                    <p class="extension-desc" id="theme-desc-{{.Slug}}">{{.Description}}</p>
                    <button type="button" class="extension-desc-toggle" hidden
                            aria-expanded="false" aria-controls="theme-desc-{{.Slug}}"
                            aria-label="{{T $ "action.expand_description"}}"
                            title="{{T $ "action.expand_description"}}"
                            data-expand-label="{{T $ "action.expand_description"}}"
                            data-collapse-label="{{T $ "action.collapse_description"}}">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                    </button>
                </div>
            </div>
        </div>
        <div class="extension-card-footer">
            <div class="extension-actions">
                {{if .Active}}
                    {{if .HasSettings}}
                    <a href="/admin/themes/{{.Slug}}/settings" class="btn btn-sm">{{T $ "action.theme_settings"}}</a>
                    {{end}}
                    {{if .HasDemoData}}
                        {{if .DemoImported}}
                            <button class="btn btn-secondary btn-sm" disabled title="{{T $ "theme.demo_imported"}}">
                                <span class="demo-check">✓</span> {{T $ "theme.demo_imported"}}
                            </button>
                        {{else}}
                            <form method="POST" action="/admin/themes/demo-import" class="inline-form"
                                  data-admin-progress
                                  data-progress-title="{{T $ "progress.demo_import_title"}}"
                                  data-progress-message="{{T $ "progress.demo_import_message"}}">
                                <input type="hidden" name="theme" value="{{.Slug}}">
                                <button type="submit" class="btn btn-accent btn-sm"
                                        onclick="return confirm('{{T $ "confirm.import_demo_data" .Name}}')">
                                    {{T $ "action.import_demo_data"}}
                                </button>
                            </form>
                        {{end}}
                    {{end}}
                {{else if .Revoked}}
                    <button class="btn btn-secondary btn-sm btn-blocked" disabled title="{{T $ "theme.revoked_cannot_switch"}}">{{T $ "ext.revoked"}}</button>
                {{else if .DepBlocked}}
                    <button class="btn btn-secondary btn-sm btn-blocked" disabled title="{{.DepReason}}">{{T $ "deps.blocked"}}</button>
                {{else}}
                    <form method="POST" action="/admin/themes/switch" class="inline-form">
                        <input type="hidden" name="theme" value="{{.Slug}}">
                        <button type="submit" class="btn btn-primary btn-sm" onclick="return confirm('{{if .DepInactiveSummary}}{{T $ "confirm.switch_theme_deps" .Name .DepInactiveSummary}}{{else}}{{T $ "confirm.switch_theme" .Name}}{{end}}{{if .ExternalSummary}} {{T $ "theme.switch_external" .ExternalSummary}}{{end}}')">{{T $ "action.enable_theme"}}</button>
                    </form>
                {{end}}
                {{if and .Package (ne .PackageSource "preview") (can $.CurrentRole "extension" "read")}}
                    <a href="/admin/themes/market?tab=installed#package-{{.Slug}}" class="btn btn-secondary btn-sm">{{T $ "theme.manage_package"}}</a>
                {{end}}
            </div>
            <div class="extension-meta">
                <span class="extension-author" title="{{T $ "theme.author"}} {{.Author}}">{{.Author}}</span>
                <span class="extension-slug" title="{{T $ "theme.identifier"}} {{.Slug}}">{{.Slug}}</span>
            </div>
        </div>
    </article>
    {{else}}
    <div class="card"><p class="empty-msg">{{T . "theme.empty"}}</p></div>
    {{end}}
</div>

{{end}}
