{{define "content"}}
<div class="content-header">
    <div class="content-header-left">
        <a href="{{.BackURL}}" class="btn btn-secondary btn-back">← {{T . "action.back_to_list"}}</a>
        <h2>{{.Title}}</h2>
    </div>
</div>
<div class="card">
    <form method="POST" action="/admin/{{.Slug}}/{{if .Item}}{{.Item.ID}}/edit{{else}}new{{end}}{{if .BackQuery}}?{{.BackQuery}}{{end}}" id="contentForm">
        <div class="content-edit-layout" data-content-edit-layout>
        <div class="content-edit-main" id="contentEditMain">
        <div class="form-group">
            <label for="title">{{T . "content.title"}} *</label>
            <input type="text" id="title" name="title" value="{{if .Item}}{{.Item.Title}}{{end}}" required>
        </div>
        <div class="form-group">
            <label for="slug">Slug *</label>
            <div class="slug-permalink-wrapper">
                <span class="permalink-prefix">{{if .TypeDef.Rewrite.Rootless}}/{{else if .TypeDef.Rewrite.Slug}}/{{.TypeDef.Rewrite.Slug}}/{{else}}/{{.TypeName}}/{{end}}</span>
                <input type="text" id="slug" name="slug" value="{{if .Item}}{{.Item.Slug}}{{end}}" required>
            </div>
            {{if .Item}}
            <small class="permalink-display">{{T . "content.permalink"}} <a href="{{.Permalink}}" target="_blank">{{.Permalink}}</a></small>
            {{end}}
        </div>

        {{if hasSupport .TypeDef.Supports "excerpt"}}
        <div class="form-group">
            <label for="excerpt">{{T . "content.excerpt"}}</label>
            <textarea id="excerpt" name="excerpt" rows="3">{{if .Item}}{{.Item.Excerpt}}{{end}}</textarea>
        </div>
        {{end}}

        {{if hasSupport .TypeDef.Supports "content"}}
        <div class="form-group">
            <label for="content">{{T . "content.content"}}</label>
            <textarea id="content" name="content" rows="12" class="rich-editor">{{if .Item}}{{.Item.Content}}{{end}}</textarea>
        </div>
        {{end}}

        {{if hasSupport .TypeDef.Supports "thumbnail"}}
        <div class="form-group">
            <label>{{T . "content.image_management"}} <small style="color:#888">({{T . "content.image_help"}})</small></label>
            <div class="image-pool-wrapper">
                <div class="image-pool-grid" id="imagePoolGrid">
                    <!-- JS renders all image cards here -->
                </div>
                <div class="image-actions" style="margin-top: 10px">
                    <button type="button" class="btn btn-sm" onclick="addImageToPool()">{{T . "content.add_image_from_media"}}</button>
                    <label class="btn btn-sm btn-primary" style="cursor:pointer">
                        {{T . "action.upload_image"}}
                        <input type="file" accept="image/*" style="display:none" onchange="uploadImageToPool(this)" multiple>
                    </label>
                </div>
                <input type="hidden" id="image_url" name="image_url" value="{{if .Item}}{{.Item.ImageURL}}{{end}}">
                <input type="hidden" id="gallery_images" name="gallery_images" value="{{if .Item}}{{metaVal .Item.Meta "gallery_images"}}{{end}}">
            </div>
        </div>
        {{end}}

        </div>
        <div class="content-edit-resizer"
            role="separator"
            tabindex="0"
            aria-label="{{T . "content.resize_editor_panels"}}"
            aria-orientation="vertical"
            aria-controls="contentEditMain contentEditSidebar"
            aria-valuemin="340"
            aria-valuemax="560"
            aria-valuenow="390"
            title="{{T . "content.resize_editor_panels"}}"
            data-content-edit-resizer></div>
        <aside class="content-edit-sidebar" id="contentEditSidebar" data-content-edit-sidebar>
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">{{T . "action.save"}}</button>
            <a href="{{.BackURL}}" class="btn">{{T . "action.cancel"}}</a>
        </div>

        <div class="content-edit-panel content-edit-options-panel">

        {{if hasSupport .TypeDef.Supports "sort_order"}}
        <div class="form-group">
            <label for="sort_order">{{T . "content.sort_order"}}</label>
            <input type="number" id="sort_order" name="sort_order" value="{{if .Item}}{{.Item.SortOrder}}{{else}}0{{end}}">
        </div>
        {{end}}

        <div class="form-group">
            <label for="status">{{T . "content.archive_status"}}</label>
            <select id="status" name="status" style="padding:0.4rem 0.8rem; border:1px solid #d1d5db; border-radius:6px;">
                {{if .CanPublish}}<option value="published" {{if .Item}}{{if eq .Item.Status "published"}}selected{{end}}{{end}}>{{T . "content.status.published"}}</option>{{else}}{{if .Item}}{{if eq .Item.Status "published"}}<option value="published" selected>{{T . "content.status.published"}}</option>{{end}}{{end}}{{end}}
                <option value="pending" {{if .Item}}{{if eq .Item.Status "pending"}}selected{{end}}{{end}}>{{T . "content.status.pending"}}</option>
                <option value="draft" {{if .Item}}{{if eq .Item.Status "draft"}}selected{{end}}{{else}}selected{{end}}>{{T . "content.status.draft"}}</option>
                <option value="archived" {{if .Item}}{{if eq .Item.Status "archived"}}selected{{end}}{{end}}>{{T . "content.status.archived"}}</option>
            </select>
        </div>

        {{if hasSupport .TypeDef.Supports "comments"}}
        <div class="form-group">
            <label for="comment_status">{{T . "content.comment_status"}}</label>
            <select id="comment_status" name="comment_status">
                <option value="open" {{if .Item}}{{if ne .Item.CommentStatus "closed"}}selected{{end}}{{else}}selected{{end}}>{{T . "content.comments_open"}}</option>
                <option value="closed" {{if .Item}}{{if eq .Item.CommentStatus "closed"}}selected{{end}}{{end}}>{{T . "content.comments_closed"}}</option>
            </select>
        </div>
        {{end}}

        {{if .ShowParentField}}
        <div class="form-group">
            <label for="parent_id">{{T . "content.parent"}}</label>
            <select id="parent_id" name="parent_id" style="padding:0.4rem 0.8rem; border:1px solid #d1d5db; border-radius:6px;">
                <option value="0">{{T . "content.parent_none"}}</option>
                {{range .ParentOptions}}
                <option value="{{.ID}}" {{if eq $.CurrentParentID .ID}}selected{{end}}>{{.Title}}</option>
                {{end}}
            </select>
        </div>
        {{end}}

        {{if .ShowPageTemplateField}}
        <div class="form-group">
            <label for="page_template">{{T . "content.page_template"}}</label>
            <select id="page_template" name="page_template" style="padding:0.4rem 0.8rem; border:1px solid #d1d5db; border-radius:6px;">
                <option value="">{{T . "content.page_template_default"}}</option>
                {{range .PageTemplateOptions}}
                <option value="{{.Template}}" {{if eq $.CurrentPageTemplate .Template}}selected{{end}}>{{.Name}}</option>
                {{end}}
            </select>
        </div>
        {{end}}

        {{if .ShowEmbedField}}
        <div class="form-group">
            <label for="embed_code">{{T . "content.embed_code"}}</label>
            <textarea id="embed_code" name="embed_code" rows="4" placeholder="<iframe ...></iframe>">{{.CurrentEmbedCode}}</textarea>
            <small>{{T . "content.embed_code_help"}}</small>
        </div>
        {{end}}

        {{if hasSupport .TypeDef.Supports "publish_date"}}
        <div class="form-group">
            <label for="published_at">{{T . "content.publish_at"}}</label>
            <input type="datetime-local" id="published_at" name="published_at" value="{{if .Item}}{{formatDateInput .Item.PublishedAt}}{{end}}">
            <small>{{T . "content.publish_at_help"}}</small>
        </div>
        {{end}}

        {{range $field := .TypeDef.MetaFields}}
        <div class="form-group">
            <label for="{{$field.Key}}">{{adminMetaFieldLabel $ $.TypeName $field.Key $field.Label}}</label>
            {{if eq $field.Type "text"}}
            <textarea id="{{$field.Key}}" name="{{$field.Key}}" rows="4">{{if $.Item}}{{metaVal $.Item.Meta $field.Key}}{{end}}</textarea>
            {{else if eq $field.Type "int"}}
            <input type="number" id="{{$field.Key}}" name="{{$field.Key}}" value="{{if $.Item}}{{metaVal $.Item.Meta $field.Key}}{{else}}{{$field.Default}}{{end}}">
            {{else if eq $field.Type "bool"}}
            <input type="checkbox" id="{{$field.Key}}" name="{{$field.Key}}" value="true" {{if $.Item}}{{if eq (metaVal $.Item.Meta $field.Key) "true"}}checked{{end}}{{end}}>
            {{else if eq $field.Type "select"}}
            <select id="{{$field.Key}}" name="{{$field.Key}}">
                <option value="">{{T $ "content.select"}}</option>
                {{range $field.Options}}
                <option value="{{.}}" {{if $.Item}}{{if eq (metaVal $.Item.Meta $field.Key) .}}selected{{end}}{{end}}>{{.}}</option>
                {{end}}
            </select>
            {{else}}
            <input type="text" id="{{$field.Key}}" name="{{$field.Key}}" value="{{if $.Item}}{{metaVal $.Item.Meta $field.Key}}{{else}}{{$field.Default}}{{end}}">
            {{end}}
        </div>
        {{end}}

        </div>

        {{/* Plugin extension slot — meta boxes contributed by plugins (e.g. seo-extras). */}}
        <div class="content-edit-extensions">{{renderHook "admin.content_form.fields" .Ctx .HookItem .TypeDef}}</div>

        {{if .TaxForms}}
        <div class="content-edit-panel content-edit-taxonomies-panel">
        {{range $tf := .TaxForms}}
        <div class="form-group">
            {{$taxLabel := adminTaxonomyLabel $.AdminLanguage $tf.TaxDef.Name $tf.TaxDef.LabelPlural}}
            <label>{{$taxLabel}}</label>
            {{if $tf.TaxDef.Hierarchical}}
            <select name="{{$tf.TaxDef.Name}}_id">
                <option value="">{{T $ "content.select"}}</option>
                {{range $item := $tf.AllItems}}
                <option value="{{$item.ID}}" {{if eq $tf.SelectedID $item.ID}}selected{{end}}>{{$item.Name}}</option>
                {{end}}
            </select>
            {{else}}
            <div class="taxonomy-token-picker"
                data-taxonomy-picker
                data-input-name="{{$tf.TaxDef.Name}}_ids"
                data-remove-label="{{T $ "taxonomy.remove_selected"}}">
                <div class="taxonomy-token-selection" role="list" aria-live="polite" aria-label="{{T $ "taxonomy.selected_items" $taxLabel}}" data-taxonomy-selection>
                    {{range $item := $tf.AllItems}}
                    {{if hasKey $tf.SelectedMap $item.ID}}
                    <span class="taxonomy-token" role="listitem" data-taxonomy-token data-taxonomy-id="{{$item.ID}}">
                        <span class="taxonomy-token-name">{{$item.Name}}</span>
                        <button type="button" class="taxonomy-token-remove" data-taxonomy-token-remove aria-label="{{T $ "taxonomy.remove_selected" $item.Name}}" title="{{T $ "taxonomy.remove_selected" $item.Name}}">×</button>
                        <input type="hidden" name="{{$tf.TaxDef.Name}}_ids" value="{{$item.ID}}">
                    </span>
                    {{end}}
                    {{end}}
                    <span class="taxonomy-token-placeholder" data-taxonomy-placeholder {{if gt (len $tf.SelectedMap) 0}}hidden{{end}}>{{T $ "taxonomy.none_selected" $taxLabel}}</span>
                </div>
                <label class="taxonomy-search-field">
                    <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
                    <span class="taxonomy-search-label">{{T $ "taxonomy.search" $taxLabel}}</span>
                    <input type="search" autocomplete="off" placeholder="{{T $ "taxonomy.search_placeholder" $taxLabel}}" aria-controls="taxonomy-candidates-{{$tf.TaxDef.Name}}" data-taxonomy-search>
                </label>
                <div class="taxonomy-candidate-list" id="taxonomy-candidates-{{$tf.TaxDef.Name}}" role="list" aria-label="{{T $ "taxonomy.available_items" $taxLabel}}" data-taxonomy-candidates>
                {{range $item := $tf.AllItems}}
                    <span role="listitem" class="taxonomy-candidate-item" data-taxonomy-candidate-item {{if hasKey $tf.SelectedMap $item.ID}}hidden{{end}}>
                        <button type="button"
                            class="taxonomy-candidate"
                            data-taxonomy-candidate
                            data-taxonomy-id="{{$item.ID}}"
                            data-taxonomy-name="{{$item.Name}}"
                            data-taxonomy-search-text="{{$item.Name}} {{$item.Slug}}"
                            data-reference-count="{{$item.ReferenceCount}}"
                            aria-pressed="{{if hasKey $tf.SelectedMap $item.ID}}true{{else}}false{{end}}"
                            title="{{T $ "taxonomy.reference_count_title" $item.ReferenceCount}}">
                            {{$item.Name}}
                        </button>
                    </span>
                {{end}}
                </div>
                <p class="taxonomy-picker-empty" data-taxonomy-empty {{if gt (len $tf.AllItems) 0}}hidden{{end}}>{{T $ "taxonomy.no_matches" $taxLabel}}</p>
            </div>
            {{end}}
        </div>
        {{end}}
        </div>
        {{end}}

        </aside>
        </div>
    </form>
</div>

<!-- Media Picker Modal -->
{{end}}
